[Unit]
Description=TVtunX tunnel exit/server instance %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/tvtunx/%i.server.env
ExecStart=/bin/sh -c '/usr/local/bin/tvtunx server -listen ${TVTUNX_LISTEN} -psk ${TVTUNX_PSK} -pad ${TVTUNX_PAD} -window ${TVTUNX_WINDOW} ${TVTUNX_EXTRA}'
Restart=always
RestartSec=2
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/etc/tvtunx
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
LimitNOFILE=1048576
MemoryHigh=384M
MemoryMax=512M

[Install]
WantedBy=multi-user.target
