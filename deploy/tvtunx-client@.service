[Unit]
Description=TVtunX tunnel relay/client instance %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/tvtunx/%i.client.env
ExecStart=/bin/sh -c '/usr/local/bin/tvtunx client -server ${TVTUNX_SERVER} -psk ${TVTUNX_PSK} -pad ${TVTUNX_PAD} -window ${TVTUNX_WINDOW} -proto ${TVTUNX_PROTO} ${TVTUNX_EXTRA} ${TVTUNX_FORWARDS}'
Restart=always
RestartSec=2
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/etc/tvtunx
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
LimitNOFILE=1048576
MemoryHigh=384M
MemoryMax=512M

[Install]
WantedBy=multi-user.target
